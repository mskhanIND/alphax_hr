   "fieldname": "gosi_wage_cap",
   "fieldtype": "Currency",
   "label": "Contributory Wage Cap",
   "default": "45000"
  },
  {
   "fieldname": "gosi_wage_floor",
   "fieldtype": "Currency",
   "label": "Contributory Wage Floor",
   "default": "0"
  },
  {
   "fieldname": "component_map",
   "fieldtype": "Table",
   "label": "Salary Component Mapping",
   "options": "AlphaX Salary Component Map",
   "description": "Tell AlphaX which salary components are Basic, Housing and the EOSB wage."
  },
  {
   "fieldname": "nitaqat_section",
   "fieldtype": "Section Break",
   "label": "Nitaqat (internal estimate)"
  },
  {
   "fieldname": "nitaqat_full_count_wage",
   "fieldtype": "Currency",
   "label": "Saudi Counts Fully From Wage",
   "default": "4000"
  },
  {
   "fieldname": "nitaqat_partial_weight",
   "fieldtype": "Float",
   "label": "Weight Below That Wage",
   "default": "0.5"
  },
  {
   "fieldname": "nitaqat_target_percent",
   "fieldtype": "Percent",
   "label": "Target Saudization %"
  },
  {
   "fieldname": "leave_section",
   "fieldtype": "Section Break",
   "label": "Leave"
  },
  {
   "fieldname": "leave_rules",
   "fieldtype": "Table",
   "label": "Statutory Leave Rules",
   "options": "AlphaX Leave Rule"
  },
  {
   "fieldname": "annual_leave_type",
   "fieldtype": "Link",
   "label": "Annual Leave Type",
   "options": "Leave Type",
   "read_only": 1,
   "description": "Set once from AlphaX → Leave setup. The leave type cannot be renamed or deleted while it is in use here."
  },
  {
   "fieldname": "annual_auto_allocate",
   "fieldtype": "Check",
   "label": "Allocate Annual Leave Automatically",
   "description": "Each service year (from the joining anniversary) gets its allocation; unused days carry forward per the Leave Type's carry-forward settings."
  },
  {
   "fieldname": "annual_policy",
   "fieldtype": "Select",
   "label": "Annual Leave Policy",
   "options": "Saudi Labor Law\nFixed for all employees",
   "default": "Saudi Labor Law",
   "description": "Saudi Labor Law: 21 days, 30 after 5 years. Fixed: the same days for everyone (e.g. 30). An employee's contract days override either; the legal minimum always applies."
  },
  {
   "fieldname": "annual_fixed_days",
   "fieldtype": "Int",
   "label": "Fixed Days per Year",
   "default": "30",
   "depends_on": "eval:doc.annual_policy=='Fixed for all employees'"
  },
  {
   "fieldname": "annual_base_days",
   "fieldtype": "Int",
   "label": "Days per Year (first 5 years)",
   "default": "21"
  },
  {
   "fieldname": "annual_senior_days",
   "fieldtype": "Int",
   "label": "Days per Year (after 5 years)",
   "default": "30"
  },
  {
   "fieldname": "annual_senior_after_years",
   "fieldtype": "Int",
   "label": "Senior Entitlement After (years)",
   "default": "5"
  },
  {
   "fieldname": "annual_senior_count_from",
   "fieldtype": "Date",
   "label": "Count Seniority From",
   "description": "Optional. Years for the senior entitlement are counted from this date (or the joining date, if later). The legal 30 days after 5 years from joining always applies."
  },
  {
   "fieldname": "leave_escalation_hours",
   "fieldtype": "Int",
   "label": "Escalate Untouched Requests After (hours)",
   "default": "48",
   "description": "0 = off"
  },
  {
   "fieldname": "employee_section",
   "fieldtype": "Section Break",
   "label": "Employee Rules"
  },
  {
   "fieldname": "probation_days",
   "fieldtype": "Int",
   "label": "Probation Period (days)",
   "default": "90",
   "description": "Saudi Labor Law allows up to 180 days."
  },
  {
   "fieldname": "permissions_per_month",
   "fieldtype": "Int",
   "label": "Late/Early Permissions per Month",
   "default": "3",
   "description": "How many late-arrival / early-exit permissions an employee may request in a month. 0 = no limit."
  },
  {
   "fieldname": "plan_max_off_percent",
   "fieldtype": "Int",
   "label": "Vacation plan: max % of a department off at once",
   "default": "30",
   "description": "Plans that push a department above this share on any day are flagged to the approver. 0 = no check."
  },
  {
   "fieldname": "plan_min_block_days",
   "fieldtype": "Int",
   "label": "Vacation plan: at least one block of (days)",
   "default": "0",
   "description": "Ask employees to plan at least one continuous vacation of this many days. 0 = no rule."
  },
  {
   "fieldname": "plan_deadline",
   "fieldtype": "Date",
   "label": "Vacation plan: submit by"
  },
  {
   "fieldname": "min_employee_age",
   "fieldtype": "Int",
   "label": "Minimum Employee Age",
   "default": "18"
  },
  {
   "fieldname": "validate_iban",
   "fieldtype": "Check",
   "label": "Validate IBAN",
   "default": "1"
  },
  {
   "fieldname": "passport_non_saudi_only",
   "fieldtype": "Check",
   "label": "Passport Mandatory Only for Non-Saudis",
   "default": "1",
   "description": "Saudis (ID starting with 1) do not need a passport number. AlphaX relaxes the site's blanket 'passport mandatory' setting and checks non-Saudis itself."
  },
