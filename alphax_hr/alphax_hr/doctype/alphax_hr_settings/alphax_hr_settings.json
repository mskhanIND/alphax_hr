  {
   "fieldname": "plan_max_off_percent",
   "fieldtype": "Int",
   "label": "Vacation plan: max % of a department off at once",
   "default": "30",
   "description": "Plans that push a department above this share on any day are flagged to the approver. 0 = no check."
