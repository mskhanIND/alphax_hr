  {
   "fieldname": "leave_rules",
   "fieldtype": "Table",
   "label": "Statutory Leave Rules",
   "options": "AlphaX Leave Rule"
  },
  {
   "fieldname": "annual_leave_type",
   "fieldtype": "Link",
   "label": "Annual Leave Type",
   "options": "Leave Type",
   "read_only": 1,
   "description": "Set once from AlphaX → Leave setup. The leave type cannot be renamed or deleted while it is in use here."
  },
  {
   "fieldname": "annual_auto_allocate",
   "fieldtype": "Check",
   "label": "Allocate Annual Leave Automatically",
   "description": "Each service year (from the joining anniversary) gets its allocation; unused days carry forward per the Leave Type's carry-forward settings."
  },
  {
   "fieldname": "annual_policy",
   "fieldtype": "Select",
   "label": "Annual Leave Policy",
   "options": "Saudi Labor Law\nFixed for all employees",
   "default": "Saudi Labor Law",
   "description": "Saudi Labor Law: 21 days, 30 after 5 years. Fixed: the same days for everyone (e.g. 30). An employee's contract days override either; the legal minimum always applies."
  },
  {
   "fieldname": "annual_fixed_days",
   "fieldtype": "Int",
   "label": "Fixed Days per Year",
   "default": "30",
   "depends_on": "eval:doc.annual_policy=='Fixed for all employees'"
  },
  {
   "fieldname": "annual_base_days",
   "fieldtype": "Int",
   "label": "Days per Year (first 5 years)",
   "default": "21"
  },
  {
   "fieldname": "annual_senior_days",
   "fieldtype": "Int",
   "label": "Days per Year (after 5 years)",
   "default": "30"
  },
  {
   "fieldname": "annual_senior_after_years",
   "fieldtype": "Int",
   "label": "Senior Entitlement After (years)",
   "default": "5"
  },
  {
   "fieldname": "annual_senior_count_from",
   "fieldtype": "Date",
   "label": "Count Seniority From",
   "description": "Optional. Years for the senior entitlement are counted from this date (or the joining date, if later). The legal 30 days after 5 years from joining always applies."
  },
  {
   "fieldname": "leave_escalation_hours",
   "fieldtype": "Int",
   "label": "Escalate Untouched Requests After (hours)",
   "default": "48",
   "description": "Requests still waiting go to the approver's own manager and HR. Applies to every approval. 0 = off"
  },
  {
   "fieldname": "approval_remind_hours",
   "fieldtype": "Int",
   "label": "Remind the Approver After (hours)",
   "default": "24",
   "description": "0 = off"
  },
  {
   "fieldname": "employee_section",
   "fieldtype": "Section Break",
   "label": "Employee Rules"
  },
  {
   "fieldname": "probation_days",
   "fieldtype": "Int",
   "label": "Probation Period (days)",
   "default": "90",
   "description": "Saudi Labor Law allows up to 180 days."
  },
  {
   "fieldname": "permissions_per_month",
   "fieldtype": "Int",
   "label": "Late/Early Permissions per Month",
   "default": "3",
   "description": "How many late-arrival / early-exit permissions an employee may request in a month. 0 = no limit."
