 "fields": [
  {
   "fieldname": "general_section",
   "fieldtype": "Section Break",
   "label": "General"
  },
  {
   "fieldname": "default_company",
   "fieldtype": "Link",
   "label": "Default Company",
   "options": "Company"
  },
  {
   "fieldname": "portal_title",
   "fieldtype": "Data",
   "label": "App name",
   "default": "AlphaX HR",
   "description": "Shown in the menu, the browser tab, the phone home screen and e-mails."
  },
  {
   "fieldname": "app_tagline",
   "fieldtype": "Data",
   "label": "Tagline",
   "description": "Small line under the name in the menu, e.g. your company name."
  },
  {
   "fieldname": "app_logo",
   "fieldtype": "Attach Image",
   "label": "Logo",
   "description": "Square or wide logo on a transparent background (PNG or SVG)."
  },
  {
   "fieldname": "app_icon",
   "fieldtype": "Attach Image",
   "label": "App icon",
   "description": "Square image (at least 512×512 PNG) for the browser tab and the phone home screen. Blank: the logo."
  },
  {
   "fieldname": "brand_login",
   "fieldtype": "Check",
   "label": "Use the name and logo on the sign-in page too",
   "default": "1"
  },
  {
   "fieldname": "default_language",
   "fieldtype": "Select",
   "label": "Default Language",
   "options": "en\nar",
   "default": "en"
  },
  {
   "fieldname": "portal_section",
   "fieldtype": "Section Break",
   "label": "HR portal and sign-in"
  },
  {
   "fieldname": "enforce_portal",
   "fieldtype": "Check",
   "label": "Keep HR, managers and employees in AlphaX (no desk)",
   "description": "Users without a desk role are sent to /alphax when they open /app, and land there after signing in."
  },
  {
   "fieldname": "desk_roles",
   "fieldtype": "Small Text",
   "label": "Roles that may still use the desk",
   "default": "System Manager\nAccounts Manager\nAccounts User",
   "description": "One role per line. Administrator always may."
  },
  {
   "fieldname": "use_alphax_login",
   "fieldtype": "Check",
   "label": "Use the AlphaX sign-in page for /login",
   "description": "Guests opening /login see the AlphaX sign-in page with your name and logo."
  },
  {
   "fieldname": "login_welcome",
   "fieldtype": "Small Text",
   "label": "Sign-in page message",
   "description": "Short text under the name, e.g. 'HR services for IRSAA staff'."
  },
  {
   "fieldname": "login_welcome_ar",
   "fieldtype": "Small Text",
   "label": "Sign-in page message (Arabic)"
  },
  {
   "fieldname": "pages_section",
   "fieldtype": "Section Break",
   "label": "Pages"
  },
  {
   "fieldname": "page_access",
   "fieldtype": "Table",
   "label": "Page access",
   "options": "AlphaX Page Access",
   "description": "Hide pages, or limit them to some roles. Pages not listed follow AlphaX's normal rules."
  },
  {
   "fieldname": "gosi_section",
   "fieldtype": "Section Break",
   "label": "GOSI"
