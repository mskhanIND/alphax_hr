  },
  {
   "fieldname": "remind_after_days",
   "fieldtype": "Int",
   "label": "HR reminder to the approver after",
   "default": "1",
   "description": "Working days after the escalation. 0 = no reminder"
  },
  {
   "fieldname": "cb3",
   "fieldtype": "Column Break"
  },
